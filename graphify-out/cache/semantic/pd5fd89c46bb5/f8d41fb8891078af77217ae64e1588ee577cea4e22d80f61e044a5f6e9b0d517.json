{"nodes": [{"id": "templates_index_appshell", "label": "Desktop App UI Shell", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "480x860px PyWebView-hosted interface with dark theme (Space Grotesk / Inter / IBM Plex Mono fonts), radial gradient background, and 28px border-radius shell. Design rationale: mobile-app-like contained window blending into the desktop."}, {"id": "templates_index_sendmessage", "label": "sendMessage() \u2014 SSE Streaming Chat", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_detectuserintent", "label": "detectUserIntent() \u2014 Client-Side Intent Detection", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performs regex-based NLP on user text before sending to backend, detecting Pomodoro, Gaming, Study, and Movie intents to pre-activate mode chips and start timers. Supplements server-side agentic function calling with instant local feedback."}, {"id": "templates_index_openvoice", "label": "openVoice() \u2014 Voice Overlay Activation", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_closevoice", "label": "closeVoice() \u2014 Voice Overlay Deactivation", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_startvoiceconversation", "label": "startVoiceConversation() \u2014 Main Voice Loop", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infinite loop cycling through Listen \u2192 Process+Stream+Speak phases. Uses continuous Web Speech API recognition with silence-based endpointing (1.8s pause = end of turn). Covers all three voice states: listening, thinking, speaking."}, {"id": "templates_index_listenoneturn", "label": "listenOneTurn() \u2014 STT with Language Fallback", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Web Speech API with cascading language fallback (fil-PH \u2192 en-PH \u2192 en-US). Continuous recognition mode with 1.8s silence timer for endpointing and 55s watchdog to prevent stuck 'Listening' state. Each language is tried in sequence if the previous yields no speech."}, {"id": "templates_index_streamandspeakresponse", "label": "streamAndSpeakResponse() \u2014 Parallel TTS and Streaming LLM", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads SSE stream from /api/voice_stream while concurrently playing pre-fetched Edge TTS audio chunks. Lazy-fetches audio with a cap of 3 queued clips to avoid memory pressure. Stop-word listener runs in parallel for barge-in via voice cues (Tagalog and English)."}, {"id": "templates_index_playaudio", "label": "playAudio() \u2014 Audio Element Playback", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_startpomodoro", "label": "startPomodoro() \u2014 Pomodoro Timer Start", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_stoppomodoro", "label": "stopPomodoro() \u2014 Pomodoro Timer Stop", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_togglepomodoro", "label": "togglePomodoro() \u2014 Pause/Resume Timer", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_pomonextaction", "label": "pomoNextAction() \u2014 Work/Break Transition", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_applypompsignals", "label": "applyPomoSignals() \u2014 Pomodoro Signal Handler", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unified handler that parses __START_POMODORO__ / __STOP_POMODORO__ sentinel tokens from LLM responses and keyword-based fallback detection, then triggers the timer UI. Shared by both text chat and voice response paths."}, {"id": "templates_index_sanitizehtml", "label": "sanitizeHtml() \u2014 XSS Sanitizer", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DOM-based HTML sanitizer that allows only a safe subset of tags and attributes from LLM output. Blocks script tags, event handlers, javascript: URLs, data: URLs, and style attributes. Renders Markdown safely via marked.js then sanitizes."}, {"id": "templates_index_pollwakeword", "label": "pollWakeword() \u2014 Wake Word Polling", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_pollmicstatus", "label": "pollMicStatus() \u2014 Microphone Status Polling", "file_type": "code", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_pomodorotimerwidget", "label": "Pomodoro Timer UI Widget", "file_type": "concept", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "25-minute work / 5-min short break / 15-min long break cycle. 4 session dots. Banner with pause/stop controls. Full-screen completion notification overlay with browser Notification API support."}, {"id": "templates_index_voiceoverlayui", "label": "Voice Conversation Overlay UI", "file_type": "concept", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen overlay with pulsing orb visualization (amber=speaking, cyan=listening, desaturated=thinking), live transcript display, STT method badge, mute/end/switch controls, and animated concentric rings."}, {"id": "templates_index_modechipsui", "label": "Mode Selection Chips UI", "file_type": "concept", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_index_wakeworddetection", "label": "Hey Hachi Wake Word Detection", "file_type": "concept", "source_file": "templates/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polls /api/wakeword_status every 600ms. On detection, shows toast notification and auto-opens voice overlay. Paused during active voice conversations to avoid concurrent microphone access."}, {"id": "templates_index_markdownrendering", "label": "Markdown Rendering via marked.js", "file_