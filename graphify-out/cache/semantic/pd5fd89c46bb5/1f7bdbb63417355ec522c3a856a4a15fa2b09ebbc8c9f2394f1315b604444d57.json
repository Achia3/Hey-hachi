{"nodes": [{"id": "readme_hachiaivoiceassistant", "label": "Hachi \u2014 Agentic AI Voice Assistant", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built for local execution using Ollama, tool calling, local SQLite memory, Microsoft Edge Neural TTS, and PyWebView desktop interface. Design intent: fully autonomous voice-enabled desktop assistant with no cloud dependency for primary operations."}, {"id": "readme_agenticfunctioncalling", "label": "Agentic Function Calling", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatically understands intent and triggers system tools without hardcoded keywords. The LLM decides which tool to call based on semantic understanding of user input rather than pattern matching."}, {"id": "readme_dualengine_routing", "label": "Qwen-First Dual-Mode Engine Routing", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qwen (local via Ollama) is the primary brain handling every request. DeepSeek (cloud) escalates only when Qwen cannot produce a valid tool call or handle complex reasoning. This keeps latency low for simple commands while providing a fallback for harder tasks. Set use_deepseek:false to run fully offline."}, {"id": "readme_sqlitememory", "label": "SQLite Local Database Memory", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracks past conversations, executed tasks, and dates so Hachi can recall historical activity. Chosen for zero-config local storage with no network dependency."}, {"id": "readme_pywebviewinterface", "label": "PyWebView Desktop Interface", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleek native desktop application window hosting the HTML/JS frontend. PyWebView chosen over Electron for lighter weight and Python-native integration."}, {"id": "readme_tagalogenglishvoice", "label": "Tagalog and English Bilingual Voice Support", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native Tagalog (fil-PH) and English speech recognition with Microsoft Edge Neural Voices (fil-PH-AngeloNeural / en-US-AvaNeural). Design choice to support the Philippine market with bilingual interaction."}, {"id": "readme_gamingmode", "label": "Gaming Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_studymode", "label": "Study Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_moviemode", "label": "Movie Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_focusmode", "label": "Focus Mode with Pomodoro Timer", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_universalappcontrol", "label": "Universal App Control", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_livewebscraping", "label": "Live Web Scraping and Weather", "file_type": "concept", "source_file": "READM